NEXT_PUBLIC_PRIMARY_API=https://streamed.pk/api/matches/football
NEXT_PUBLIC_BACKUP_API=https://api.cdnlivetv.tv/api/v1/events/sports/?user=cdnlivetv&plan=free
NEXT_PUBLIC_PRIMARY_STREAM=https://streamed.pk/api/stream

# Live TV feature flag: unset/false hides all channel listings, channel
# playback pages, the IPTV catalogue and feed-based fallback streams.
# Set to the exact value "true" to re-enable Live TV everywhere at once.
# NEXT_PUBLIC_LIVE_TV_ENABLED=

# IPTV catalogue (only used when Live TV is enabled). Playlists come from the
# daftarlayl2-creator/iptv repository (streams/{cc}.m3u on master).
# IPTV_COUNTRIES=ma,dz,tn,eg,sa,ae,qa,fr,es,uk
# Full URL overrides are allowlisted to that repository; others are dropped:
# IPTV_PLAYLIST_URLS=
# IPTV_REPO_RAW_BASE=https://raw.githubusercontent.com/daftarlayl2-creator/iptv/master/streams
# IPTV_CATALOG_TTL_S=900

# Secret used to HMAC-sign /api/stream-redirect and /api/proxy links
STREAM_SECRET=

# Allow /api/proxy to reach LAN / loopback origins (local testing, self-hosted restreamers). Default: off
# HLS_PROXY_ALLOW_PRIVATE_HOSTS=true

# Comma-separated M3U/JSON live feeds. Unset enables Live-events + official IPTV-Org sports + Guovin IPTV-API.
# An explicit list REPLACES those defaults; an empty string disables all feeds.
# Official source: https://iptv-org.github.io/iptv/categories/sports.m3u
# Pages/raw failures fall back to the same sports file in IPTV-Org's gh-pages branch.
# Guovin result.m3u tries https://guovin.github.io/iptv-api/ipv4.m3u first, then release/gd mirrors.
# Official Guovin/IPTV-Org channels stay in the hidden resolver pool, not the navigation grid.
# LIVE_FEED_URLS=https://raw.githubusercontent.com/ibstvofficial/Live-events/main/playlist.m3u,https://iptv-org.github.io/iptv/categories/sports.m3u,https://guovin.github.io/iptv-api/result.m3u
# GitHub API-only transport (same official data, useful when Pages/raw are blocked):
# LIVE_FEED_URLS=https://api.github.com/repos/iptv-org/iptv/contents/categories/sports.m3u?ref=gh-pages

# Optional: TheSportsDB API key for player cutouts on /player/[id] (free tier key by default)
# THESPORTSDB_API_KEY=123

# Optional: Supabase fan accounts/email confirmation + shared chat/predictions.
# Without these, accounts/chat/votes remain device-local. See README for the schema.
# Add your exact public /auth/callback URL in Supabase Auth redirect allowlists.
# Email templates, cross-device token_hash links and preview setup: docs/feature-expansion.md.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical SEO origin (set to your real HTTPS production origin, not an Arena preview URL).
# Default: https://www.eviv.si. NEXT_PUBLIC_SITE_URL is also accepted.
# SITE_URL=https://www.eviv.si

# Paid passes: optional authenticated HTTPS billing adapter, NOT a built-in merchant integration.
# All values are server-only; never use NEXT_PUBLIC_ for keys. Setup: docs/subscriptions.md.
# Without all four valid settings, checkout is disabled and everyone retains free HD + ads.
# Generate TWO DIFFERENT random keys: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# STREAM_SECRET=<random media key, at least 32 characters; replace the empty value above>
# SUBSCRIPTION_SECRET=<different random stable cookie key, at least 32 characters>
# BILLING_API_URL=https://your-billing-adapter.example/v1
# BILLING_API_KEY=<server-to-server bearer key>
