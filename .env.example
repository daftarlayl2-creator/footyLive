NEXT_PUBLIC_PRIMARY_API=https://streamed.pk/api/matches/football
NEXT_PUBLIC_BACKUP_API=https://api.cdnlivetv.tv/api/v1/events/sports/?user=cdnlivetv&plan=free
NEXT_PUBLIC_PRIMARY_STREAM=https://streamed.pk/api/stream

# Secret used to HMAC-sign /api/stream-redirect and /api/proxy links
STREAM_SECRET=change_me_to_a_long_random_string

# Allow /api/proxy to reach LAN / loopback origins (local testing, self-hosted restreamers). Default: off
# HLS_PROXY_ALLOW_PRIVATE_HOSTS=true

# Comma-separated M3U/JSON live feed URLs (default: ibstvofficial/Live-events playlist). Empty string disables feeds.
# LIVE_FEED_URLS=https://raw.githubusercontent.com/ibstvofficial/Live-events/main/playlist.m3u
