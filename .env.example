NEXT_PUBLIC_PRIMARY_API=https://streamed.pk/api/matches/football
NEXT_PUBLIC_BACKUP_API=https://api.cdnlivetv.tv/api/v1/events/sports/?user=cdnlivetv&plan=free
NEXT_PUBLIC_PRIMARY_STREAM=https://streamed.pk/api/stream

# Secret used to HMAC-sign /api/stream-redirect and /api/proxy links
STREAM_SECRET=change_me_to_a_long_random_string

# Allow /api/proxy to reach LAN / loopback origins (local testing, self-hosted restreamers). Default: off
# HLS_PROXY_ALLOW_PRIVATE_HOSTS=true

# Comma-separated M3U/JSON live feeds. Unset enables Live-events + official IPTV-Org sports.
# An explicit list REPLACES those defaults; an empty string disables all feeds.
# Official source: https://iptv-org.github.io/iptv/categories/sports.m3u
# Pages/raw failures fall back to the same sports file in IPTV-Org's gh-pages branch.
# LIVE_FEED_URLS=https://raw.githubusercontent.com/ibstvofficial/Live-events/main/playlist.m3u,https://iptv-org.github.io/iptv/categories/sports.m3u
# GitHub API-only transport (same official data, useful when Pages/raw are blocked):
# LIVE_FEED_URLS=https://api.github.com/repos/iptv-org/iptv/contents/categories/sports.m3u?ref=gh-pages

# Optional: Supabase fan accounts/email confirmation + shared chat/predictions.
# Without these, accounts/chat/votes remain device-local. See README for the schema.
# Add your exact public /auth/callback URL in Supabase Auth redirect allowlists.
# Email templates, cross-device token_hash links and preview setup: docs/feature-expansion.md.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
